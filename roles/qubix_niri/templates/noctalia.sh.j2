#!/usr/bin/env bash
# Use Noctalia's profile roots; applications keep ordinary XDG configuration.
set -euo pipefail
if [[ "${1:-}" == --application ]]; then
  shift
  if (( $# == 0 )); then exit 2; fi
  if [[ "${QUBIX_NATIVE_GSETTINGS_BACKEND_SET:-0}" == 1 ]]; then
    export GSETTINGS_BACKEND="$QUBIX_NATIVE_GSETTINGS_BACKEND"
  else
    unset GSETTINGS_BACKEND
  fi
  unset QUBIX_NATIVE_GSETTINGS_BACKEND QUBIX_NATIVE_GSETTINGS_BACKEND_SET
  exec "$@"
fi
# Noctalia 5.2 always invokes gsettings; keep that preference write transient.
if [[ "${GSETTINGS_BACKEND+x}" == x ]]; then
  export QUBIX_NATIVE_GSETTINGS_BACKEND_SET=1
  export QUBIX_NATIVE_GSETTINGS_BACKEND="$GSETTINGS_BACKEND"
else
  export QUBIX_NATIVE_GSETTINGS_BACKEND_SET=0
fi
export GSETTINGS_BACKEND=memory
export NOCTALIA_CONFIG_HOME=/etc/qubix
export NOCTALIA_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/qubix"
export NOCTALIA_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/qubix"
export TERMINAL=/usr/bin/foot
qubix_shell_binary='{{ "/usr/share/qubix/bin/noctalia" if (qubix_profile_resolved.niri | default({})).get("presentation", "native") == "qubix" else "/usr/bin/noctalia" }}'
if [[ "$qubix_shell_binary" == /usr/share/qubix/bin/noctalia ]]; then
  qubix_native_sha256='{{ qubix_niri_ui_native_sha256 | default("") }}'
  if ! printf '%s  /usr/bin/noctalia\n' "$qubix_native_sha256" | /usr/bin/sha256sum --check --status; then
    printf '%s\n' 'QubixOS captions need a matching rebuild; using updated native Noctalia.' >&2
    qubix_shell_binary=/usr/bin/noctalia
  fi
fi
exec "$qubix_shell_binary" "$@"
