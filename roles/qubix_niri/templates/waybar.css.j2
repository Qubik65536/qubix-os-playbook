* { font-family: monospace; font-size: 13px; }
window#waybar { background: #1b242c; color: #cfdae2; }
#custom-qubix, #clock, #cpu, #memory, #tray { padding: 0 12px; }
#custom-qubix { color: #94a9ba; font-weight: bold; }
#workspaces button { color: #7490a9; border-radius: 4px; }
#workspaces button.active { background: #3a4e5f; color: #f2f5f8; }
