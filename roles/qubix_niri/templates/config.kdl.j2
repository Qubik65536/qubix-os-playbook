// Qubix Niri: native /etc/niri and personal dotfiles remain preserved.
input {
    keyboard { xkb {}; }
    touchpad { tap; natural-scroll; }
}
{% include 'theme.kdl.j2' %}

hotkey-overlay { skip-at-startup; }

spawn-at-startup "/usr/share/qubix/bin/qubix-noctalia"
binds {
    Mod+T hotkey-overlay-title="Terminal" { spawn "/usr/bin/foot" "--config=/etc/qubix/foot.ini"; }
    Mod+Return { spawn "/usr/bin/foot" "--config=/etc/qubix/foot.ini"; }
    Mod+Space hotkey-overlay-title="Launcher" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+D { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "settings-toggle"; }
    Mod+N hotkey-overlay-title="Notifications" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Y hotkey-overlay-title="Wallpapers" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+O repeat=false { toggle-overview; }
    Alt+Tab hotkey-overlay-title="Window switcher" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "window-switcher"; }
    Mod+W repeat=false { close-window; }
    Mod+Q repeat=false { close-window; }
    Mod+Ctrl+W { toggle-column-tabbed-display; }
    Mod+Shift+E { quit; }
    Mod+X hotkey-overlay-title="Session menu" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "session"; }
    Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "session" "lock"; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+S { screenshot; }
    Print { screenshot; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "volume-up" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "volume-down" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "mic-mute"; }
    XF86AudioPlay allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "brightness-up" "all" "5"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "brightness-down" "all" "5"; }
}
