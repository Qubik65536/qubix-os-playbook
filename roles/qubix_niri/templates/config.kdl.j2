// Qubix Niri: native /etc/niri and personal dotfiles remain preserved.
environment {
    TERMINAL "/usr/share/qubix/bin/qubix-wezterm"
}
input {
    keyboard { xkb {}; }
    touchpad { tap; natural-scroll; }
}
{% include 'theme.kdl.j2' %}

hotkey-overlay { skip-at-startup; }

spawn-at-startup "/usr/share/qubix/bin/qubix-output-defaults"
spawn-at-startup "/usr/share/qubix/bin/qubix-noctalia"
binds {
    Mod+T hotkey-overlay-title="Applications / Terminal" { spawn "/usr/share/qubix/bin/qubix-wezterm" "start"; }
    Mod+Return hotkey-overlay-title="Applications / Terminal" { spawn "/usr/share/qubix/bin/qubix-wezterm" "start"; }
    Mod+Space hotkey-overlay-title="Applications / App launcher" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+D hotkey-overlay-title="Applications / App launcher" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+V hotkey-overlay-title="Applications / Clipboard history" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Comma hotkey-overlay-title="Applications / Shell settings" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "settings-toggle"; }
    Mod+N hotkey-overlay-title="Session / Notifications" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Y hotkey-overlay-title="Applications / Wallpaper picker" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Tab hotkey-overlay-title="Windows / Overview" repeat=false { toggle-overview; }
    Mod+O hotkey-overlay-title="Windows / Overview" repeat=false { toggle-overview; }
    Alt+Tab hotkey-overlay-title="Windows / Window switcher" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "window-switcher"; }
    Mod+W hotkey-overlay-title="Windows / Close window" repeat=false { close-window; }
    Mod+Q hotkey-overlay-title="Windows / Close window" repeat=false { close-window; }
    Mod+Ctrl+W hotkey-overlay-title="Windows / Toggle tabbed column" { toggle-column-tabbed-display; }
    Mod+Ctrl+Left hotkey-overlay-title="Windows / Resize column narrower" { set-column-width "-5%"; }
    Mod+Ctrl+H hotkey-overlay-title="Windows / Resize column narrower" { set-column-width "-5%"; }
    Mod+Ctrl+Right hotkey-overlay-title="Windows / Resize column wider" { set-column-width "+5%"; }
    Mod+Ctrl+L hotkey-overlay-title="Windows / Resize column wider" { set-column-width "+5%"; }
    Mod+Ctrl+Up hotkey-overlay-title="Windows / Resize window shorter" { set-window-height "-5%"; }
    Mod+Ctrl+K hotkey-overlay-title="Windows / Resize window shorter" { set-window-height "-5%"; }
    Mod+Ctrl+Down hotkey-overlay-title="Windows / Resize window taller" { set-window-height "+5%"; }
    Mod+Ctrl+J hotkey-overlay-title="Windows / Resize window taller" { set-window-height "+5%"; }
    Mod+Ctrl+R hotkey-overlay-title="Windows / Reset window height" { reset-window-height; }
    Mod+Shift+E hotkey-overlay-title="Session / Exit session" { quit; }
    Mod+X hotkey-overlay-title="Session / Power options" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "qubix/power:menu"; }
    Mod+Alt+L hotkey-overlay-title="Session / Lock screen" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "session" "lock"; }
    Mod+H hotkey-overlay-title="Navigation / Focus left" { focus-column-left; }
    Mod+L hotkey-overlay-title="Navigation / Focus right" { focus-column-right; }
    Mod+J hotkey-overlay-title="Navigation / Focus down" { focus-window-down; }
    Mod+K hotkey-overlay-title="Navigation / Focus up" { focus-window-up; }
    Mod+Left hotkey-overlay-title="Navigation / Focus left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Navigation / Focus right" { focus-column-right; }
    Mod+Down hotkey-overlay-title="Navigation / Focus down" { focus-window-down; }
    Mod+Up hotkey-overlay-title="Navigation / Focus up" { focus-window-up; }
    Mod+Shift+H hotkey-overlay-title="Navigation / Move left" { move-column-left; }
    Mod+Shift+L hotkey-overlay-title="Navigation / Move right" { move-column-right; }
    Mod+Shift+J hotkey-overlay-title="Navigation / Move down" { move-window-down; }
    Mod+Shift+K hotkey-overlay-title="Navigation / Move up" { move-window-up; }
    Mod+Shift+Left hotkey-overlay-title="Navigation / Move left" { move-column-left; }
    Mod+Shift+Right hotkey-overlay-title="Navigation / Move right" { move-column-right; }
    Mod+Shift+Down hotkey-overlay-title="Navigation / Move down" { move-window-down; }
    Mod+Shift+Up hotkey-overlay-title="Navigation / Move up" { move-window-up; }
    Mod+Page_Down hotkey-overlay-title="Navigation / Next workspace" { focus-workspace-down; }
    Mod+Page_Up hotkey-overlay-title="Navigation / Previous workspace" { focus-workspace-up; }
    Mod+Shift+Page_Down hotkey-overlay-title="Navigation / Move to next workspace" { move-column-to-workspace-down; }
    Mod+Shift+Page_Up hotkey-overlay-title="Navigation / Move to previous workspace" { move-column-to-workspace-up; }
    Mod+R hotkey-overlay-title="Windows / Cycle column width" { switch-preset-column-width; }
    Mod+F hotkey-overlay-title="Windows / Maximize column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Windows / Fullscreen window" { fullscreen-window; }
    Mod+Shift+T hotkey-overlay-title="Windows / Toggle floating" { toggle-window-floating; }
    Mod+Shift+S hotkey-overlay-title="Applications / Take screenshot" { screenshot; }
    Print hotkey-overlay-title="Applications / Take screenshot" { screenshot; }
    Mod+Shift+Slash hotkey-overlay-title="Session / Keyboard shortcuts" { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "panel-toggle" "qubix/shortcuts:cheatsheet"; }
    Mod+F1 hotkey-overlay-title="Session / Compact shortcut overlay" { show-hotkey-overlay; }
    XF86AudioRaiseVolume hotkey-overlay-title="Media / Volume up" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "volume-up" "3"; }
    XF86AudioLowerVolume hotkey-overlay-title="Media / Volume down" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "volume-down" "3"; }
    XF86AudioMute hotkey-overlay-title="Media / Mute speakers" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute hotkey-overlay-title="Media / Mute microphone" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "mic-mute"; }
    XF86AudioPlay hotkey-overlay-title="Media / Play or pause" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "play-pause"; }
    XF86AudioPause hotkey-overlay-title="Media / Play or pause" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "play-pause"; }
    XF86AudioNext hotkey-overlay-title="Media / Next track" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "next"; }
    XF86AudioPrev hotkey-overlay-title="Media / Previous track" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "media" "previous"; }
    XF86MonBrightnessUp hotkey-overlay-title="Media / Brightness up" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "brightness-up" "all" "5"; }
    XF86MonBrightnessDown hotkey-overlay-title="Media / Brightness down" allow-when-locked=true { spawn "/usr/share/qubix/bin/qubix-noctalia" "msg" "brightness-down" "all" "5"; }
}
spawn-at-startup "/bin/sh" "-c" "if [ -x /usr/lib/pam_kwallet_init ]; then /usr/lib/pam_kwallet_init; fi"
