// Qubix palette. Users may include this file explicitly in their own configuration.
layout {
    gaps 12
    background-color "#1B242C"
    focus-ring {
        width 2
        active-color "#56728B"
        inactive-color "#3A4E5F"
    }
    border { off; }
}
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}
// Keep focus-ring fill from masking the terminal's own background transparency.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    draw-border-with-background false
}
