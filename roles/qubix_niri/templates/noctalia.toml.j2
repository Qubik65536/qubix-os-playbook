# Qubix shell defaults. GUI overrides belong to the Qubix-only user state root.
[theme]
source = "custom"
custom_palette = "Qubix"
mode = "dark"

[theme.templates]
enable_builtin_templates = false
enable_community_templates = false
builtin_ids = []
community_ids = []

[shell]
font_family = "{{ 'Monaspace Krypton NF' if (qubix_profile_resolved.fonts | default({})).get('krypton_ui', false) else 'sans-serif' }}"
corner_radius_scale = 1.35
setup_wizard_enabled = false
polkit_agent = true
telemetry_enabled = false
external_ip_enabled = false
screen_time_enabled = false
launch_apps_custom_command = "/usr/share/qubix/bin/qubix-noctalia --application $CMD"

[shell.panel]
launcher_placement = "floating"
launcher_position = "center"
clipboard_placement = "floating"
clipboard_position = "center"
shadow = true

[shell.launcher]
fetch_exchange_rates = false
pinned = ["qubix-power"]

[shell.launcher.providers.session]
prefix = "session"
global = true

# The Control Center retains the native menu; give that fallback a countdown too.
[[shell.session.actions]]
action = "lock"
shortcut = "1"
countdown_seconds = 5

[[shell.session.actions]]
action = "logout"
shortcut = "2"
countdown_seconds = 5

[[shell.session.actions]]
action = "lock_and_suspend"
shortcut = "3"
countdown_seconds = 5

[[shell.session.actions]]
action = "reboot"
shortcut = "4"
countdown_seconds = 5

[[shell.session.actions]]
action = "shutdown"
variant = "destructive"
shortcut = "5"
countdown_seconds = 5

[bar.default]
position = "top"
thickness = 32
margin_edge = 6
margin_ends = 10
radius = 6
radius_top_left = 6
radius_top_right = 6
radius_bottom_left = 6
radius_bottom_right = 6
concave_edge_corners = false
background_opacity = 0.0
border_width = 0.0
shadow = false
widget_spacing = 6
font_scale = 0.9
capsule = true
capsule_fill = "#11191f"
capsule_foreground = "on_surface"
capsule_thickness = 0.875
capsule_padding = 8
capsule_radius = 6.0
capsule_opacity = 1.0
capsule_border = "#56728b66"
capsule_border_width = 1.0
start = ["launcher", "workspaces", "shortcuts", "active-window"]
center = ["media"]
end = ["cpu", "ram", "temp", "tray", "network", "volume", "battery", "notifications", "clock", "control-center", "session"]

[widget.launcher]
custom_image = "/usr/share/qubix/branding/logo.png"
custom_image_colorize = false
scale = 1.5
capsule_padding = 3
capsule_fill = "primary"

[widget.clock]
format = "{:%a %d · %H:%M}"
font_weight = 600

[widget.workspaces]
capsule_fill = "#17232d"

[widget.active-window]
type = "active_window"
display = "icon_and_text"
icon_size = 14
min_length = 40
max_length = 190
title_scroll = "on_hover"
show_empty_label = false

[widget.media]
hide_when_no_media = true
hide_album_art = true
hide_artist = true
min_length = 60
max_length = 150
title_scroll = "on_hover"

[widget.cpu]
type = "sysmon"
stat = "cpu_usage"
custom_label = "CPU"
show_glyph = false
visualization = "none"
highlight_color = "primary"

[widget.ram]
type = "sysmon"
stat = "ram_used"
custom_label = "RAM"
show_glyph = false
visualization = "none"
highlight_color = "primary"

[widget.temp]
type = "sysmon"
stat = "cpu_temp"
visualization = "none"
highlight_color = "primary"

[widget.network]
show_label = false

[widget.shortcuts]
type = "custom_button"
glyph = "keyboard"
tooltip = "Keyboard shortcuts (Super+Shift+/)"

[widget.shortcuts.actions]
left = "panel-toggle qubix/shortcuts:cheatsheet"

[widget.session]
type = "custom_button"
glyph = "shutdown"
tooltip = "Power options (Super+X)"

[widget.session.actions]
left = "panel-toggle qubix/power:menu"

[dock]
enabled = false
reserve_space = false

[wallpaper]
enabled = true
directory = "/usr/share/qubix"
fill_mode = "crop"
transition = ["fade"]

[wallpaper.default]
path = "/usr/share/qubix/wallpaper.png"

[notification]
enable_daemon = true
border_color = "primary"

[plugins]
enabled = ["qubix/shortcuts", "qubix/power"]
auto_update = "none"

[[plugins.source]]
name = "qubix"
kind = "path"
location = "/usr/share/qubix/noctalia/plugins"
enabled = true
