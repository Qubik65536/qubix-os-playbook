# Qubix shell defaults. GUI overrides belong to the Qubix-only user state root.
[theme]
source = "custom"
custom_palette = "Qubix"
mode = "dark"

[theme.templates]
enable_builtin_templates = false
enable_community_templates = false
builtin_ids = []
community_ids = []

[shell]
corner_radius_scale = 1.35
setup_wizard_enabled = false
polkit_agent = true
telemetry_enabled = false
external_ip_enabled = false
screen_time_enabled = false
launch_apps_custom_command = "/usr/share/qubix/bin/qubix-noctalia --application $CMD"

[shell.panel]
launcher_placement = "floating"
launcher_position = "center"
clipboard_placement = "floating"
clipboard_position = "center"
shadow = true

[shell.launcher]
fetch_exchange_rates = false
pinned = ["qubix-power"]

[shell.launcher.providers.session]
prefix = "session"
global = true

[bar.default]
position = "top"
thickness = 36
margin_edge = 8
margin_ends = 12
radius = 12
radius_top_left = 12
radius_top_right = 12
radius_bottom_left = 12
radius_bottom_right = 12
concave_edge_corners = false
background_opacity = 0.0
border_width = 0.0
shadow = false
widget_spacing = 8
capsule = true
capsule_fill = "surface"
capsule_foreground = "on_surface"
capsule_thickness = 0.86
capsule_padding = 10
capsule_radius = 10.0
capsule_opacity = 0.96
capsule_border = "#56728b4d"
capsule_border_width = 1.0
start = ["launcher", "workspaces", "shortcuts"]
center = ["clock"]
end = ["tray", "notifications", "network", "volume", "battery", "control-center", "session"]

[widget.launcher]
custom_image = "/usr/share/qubix/branding/logo.png"
custom_image_colorize = false
capsule_fill = "primary"

[widget.clock]
font_weight = 600
capsule_fill = "surface_variant"

[widget.workspaces]
capsule_fill = "surface_variant"

[widget.shortcuts]
type = "custom_button"
glyph = "keyboard"
tooltip = "Keyboard shortcuts (Super+Shift+/)"

[widget.shortcuts.actions]
left = "panel-toggle qubix/shortcuts:cheatsheet"

[dock]
enabled = false
reserve_space = false

[wallpaper]
enabled = true
directory = "/usr/share/qubix"
fill_mode = "crop"
transition = ["fade"]

[wallpaper.default]
path = "/usr/share/qubix/wallpaper.png"

[notification]
enable_daemon = true
border_color = "primary"

[plugins]
enabled = ["qubix/shortcuts"]
auto_update = "none"

[[plugins.source]]
name = "qubix"
kind = "path"
location = "/usr/share/qubix/noctalia/plugins"
enabled = true
