# Qubix boot, reboot and poweroff theme. Password callbacks receive counts only.
Window.SetBackgroundTopColor(0.106, 0.141, 0.173);
Window.SetBackgroundBottomColor(0.106, 0.141, 0.173);
logo = Image("logo.png").Scale(160, 160);
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - 150);
brand = Image.Text("QUBIX OS", 0.949, 0.961, 0.973, 1, "Sans 18");
brand_sprite = Sprite(brand);
brand_sprite.SetX(Window.GetWidth() / 2 - brand.GetWidth() / 2);
brand_sprite.SetY(Window.GetHeight() / 2 + 20);
caption = "Starting Qubix OS";
if (Plymouth.GetMode() == "shutdown") caption = "Shutting down Qubix OS";
if (Plymouth.GetMode() == "reboot") caption = "Restarting Qubix OS";
frame = 0;
prompt_active = 0;
dot_image = Image.Text("•", 0.337, 0.447, 0.545, 1, "Sans 18");
for (index = 0; index < 12; index++) {
    angle = index * 6.283185 / 12;
    dots[index].sprite = Sprite(dot_image);
    dots[index].sprite.SetX(Window.GetWidth() / 2 + Math.Sin(angle) * 18 - dot_image.GetWidth() / 2);
    dots[index].sprite.SetY(Window.GetHeight() / 2 + 85 - Math.Cos(angle) * 18 - dot_image.GetHeight() / 2);
}
text_sprite = Sprite();
text_sprite.SetZ(100);
fun show_text(text) {
    image = Image.Text(text, 0.812, 0.855, 0.886, 1, "Sans 12");
    text_sprite.SetImage(image);
    text_sprite.SetX(Window.GetWidth() / 2 - image.GetWidth() / 2);
    text_sprite.SetY(Window.GetHeight() / 2 + 125);
}
fun refresh_callback() {
    global.frame++;
    phase = Math.Int(global.frame / 3) % 12;
    for (index = 0; index < 12; index++) {
        distance = (index - phase + 12) % 12;
        dots[index].sprite.SetOpacity((1 - distance / 14) * (1 - global.prompt_active));
    }
}
fun normal_callback() {
    global.prompt_active = 0;
    show_text(caption);
}
fun password_callback(prompt, bullets) {
    global.prompt_active = 1;
    stars = "";
    for (index = 0; index < bullets; index++) stars = stars + "*";
    show_text(prompt + " " + stars);
}
fun question_callback(prompt, entry) {
    global.prompt_active = 1;
    show_text(prompt + " " + entry);
}
fun message_callback(message) {
    show_text(message);
}
Plymouth.SetRefreshRate(30);
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(normal_callback);
normal_callback();
