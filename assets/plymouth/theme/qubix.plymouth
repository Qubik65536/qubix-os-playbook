[Plymouth Theme]
Name=Qubix
Description=Midnight Qubix spinner with Krypton-derived typography
ModuleName=two-step

[two-step]
Font=Qubix Boot Mono 12
TitleFont=Qubix Boot Mono 26
MonospaceFont=Qubix Boot Mono 10
ImageDir=/usr/share/plymouth/themes/qubix
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.7
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.93
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x070c12
BackgroundEndColor=0x101b26
ProgressBarBackgroundColor=0x293f54
ProgressBarForegroundColor=0xedf6ff
ConsoleLogTextColor=0xf4f8fc
ConsoleLogBackgroundColor=0x070c12
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false
